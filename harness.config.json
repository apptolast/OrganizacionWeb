{
  "$schema": "./harness.schema.json",
  "project": "OrganizationWeb",
  "language": "java-typescript",
  "description": "React SCSS + Spring Boot hexagonal. PostgreSQL integration is mandatory in test.",
  "commands": {
    "install": "node scripts/project.mjs install",
    "lint": "node scripts/project.mjs lint",
    "test": "node scripts/project.mjs test",
    "mutate": "node scripts/project.mjs mutate {{target}}",
    "build": "node scripts/project.mjs build"
  },
  "paths": {
    "src": "backend/src/main",
    "tests": "backend/src/test"
  },
  "mutation": {
    "threshold": 0.8,
    "targets": []
  },
  "rules": {
    "require_tests_to_close": true,
    "require_mutation_to_close": true
  }
}

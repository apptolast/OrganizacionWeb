{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/App.tsx:29:8-29:45",
    "src/App.tsx:37:8-51:28",
    "src/App.tsx:54:7-97:7",
    "src/workspace.tsx:81:10-86:22",
    "src/session-gate.tsx:44:10-44:37",
    "src/use-session.ts:190:6-190:29",
    "src/export-data-api.ts",
    "src/export-data.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-export-data/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-export-data/mutation.html"
  },
  "tempDirName": ".stryker-tmp-export-data"
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/today-api.ts",
    "src/today.tsx",
    "src/App.tsx:10:0-49:1",
    "src/workspace.tsx:27:0-54:22",
    "src/workspace.tsx:85:0-85:64",
    "src/project-reader.tsx:61:0-61:70",
    "src/project-reader.tsx:157:0-157:76",
    "src/use-session.ts:29:0-29:43",
    "src/use-session.ts:189:0-189:36"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-today/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-today/mutation.html"
  }
}

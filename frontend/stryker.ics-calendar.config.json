{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/App.tsx:40:8-40:42",
    "src/App.tsx:65:20-66:34",
    "src/App.tsx:106:10-107:37",
    "src/workspace.tsx:99:10-104:22",
    "src/calendar-feed-api.ts",
    "src/calendar.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-ics-calendar/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-ics-calendar/mutation.html"
  },
  "tempDirName": ".stryker-tmp-ics-calendar"
}

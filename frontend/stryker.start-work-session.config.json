{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/work-session-api.ts",
    "src/work-session.tsx",
    "src/task-reader.tsx:124:0-135:12"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": { "high": 90, "low": 80, "break": 80 },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": { "configFile": "vite.config.ts" },
  "jsonReporter": {
    "fileName": "reports/mutation-start-work-session/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-start-work-session/mutation.html"
  }
}

            "schema": {
              "format": "uuid",
              "type": "string"
            }
          },
          {
            "schema": {
              "type": "string"
            },
            "name": "If-Match",
            "in": "header",
            "required": true,
            "description": "ETag fuerte vigente obtenido por GET de proyecto; formato UUID:revision entre comillas."
          }
        ],
        "responses": {
          "200": {
            "description": "Respuesta del contrato vigente de esta operación.",
            "headers": {
              "ETag": {
                "schema": {
                  "type": "string"
                },
                "description": "ETag fuerte de identidad y revisión del proyecto."
              }
            }

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/api-client.ts",
    "src/session-api.ts",
    "src/use-session.ts",
    "src/session-gate.tsx:22:0-31:100",
    "src/use-create-project.ts:10:0-11:100",
    "src/use-create-project.ts:40:0-46:100",
    "src/projects-api.ts:43:0-43:100"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-authentication/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-authentication/mutation.html"
  }
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignorePatterns": [
    ".stryker-tmp-*"
  ],
  "mutate": [
    "src/external-calendar-api.ts",
    "src/external-calendar.tsx",
    "src/today-external-calendar.tsx",
    "src/App.tsx:46:8-46:58",
    "src/App.tsx:59:14-81:40",
    "src/App.tsx:92:10-151:7",
    "src/workspace.tsx:81:10-86:22"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html",
    "progress-append-only"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-external-calendar/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-external-calendar/mutation.html"
  },
  "tempDirName": ".stryker-tmp-external-calendar"
}

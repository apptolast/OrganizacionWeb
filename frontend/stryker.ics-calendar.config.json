{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/App.tsx:38:8-38:42",
    "src/App.tsx:59:18-60:32",
    "src/App.tsx:96:10-97:37",
    "src/workspace.tsx:98:10-103:22",
    "src/calendar-feed-api.ts",
    "src/calendar.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-ics-calendar/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-ics-calendar/mutation.html"
  },
  "tempDirName": ".stryker-tmp-ics-calendar"
}

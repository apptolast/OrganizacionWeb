{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/import-data-api.ts",
    "src/import-data-intent.ts",
    "src/import-data.tsx",
    "src/App.tsx:32:8-32:41",
    "src/App.tsx:39:8-39:45",
    "src/App.tsx:55:14-73:36",
    "src/App.tsx:84:10-139:7",
    "src/workspace.tsx:97:10-105:22",
    "src/use-session.ts:9:0-20:1",
    "src/use-session.ts:53:6-64:36",
    "src/use-session.ts:82:6-82:29",
    "src/use-session.ts:157:4-157:27",
    "src/use-session.ts:222:6-222:29",
    "src/appearance-state.tsx:35:2-37:3",
    "src/appearance-state.tsx:171:8-177:9",
    "src/customization-state.ts:411:4-466:5"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-import-data/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-import-data/mutation.html"
  },
  "tempDirName": ".stryker-tmp-import-data",
  "incremental": true,
  "incrementalFile": "../progress/import_stryker_incremental/cache.json"
}

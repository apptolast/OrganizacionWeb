DB_USERNAME=
DB_PASSWORD=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
WEB_PORT=8080
# Leave empty for local HTTP; set the exact HTTPS origin behind your TLS proxy.
# Example: https://organization.example.com (no trailing slash).
APP_PUBLIC_ORIGIN=
# Active projects per owner, integer 1-10; all replicas use the same value.
APP_MAX_ACTIVE_PROJECTS=3

# Optional publisher stack (deploy/compose.publisher.yml)
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

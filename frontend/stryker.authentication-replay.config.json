{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/api-client.ts:10:0-10:100",
    "src/api-client.ts:33:0-34:100",
    "src/session-api.ts:20:0-23:120",
    "src/session-gate.tsx:26:0-26:100",
    "src/use-session.ts:12:0-15:100",
    "src/use-session.ts:23:0-23:100",
    "src/use-session.ts:39:0-40:100",
    "src/use-session.ts:53:0-54:100",
    "src/use-session.ts:86:0-86:100",
    "src/use-session.ts:91:0-91:100",
    "src/use-session.ts:139:0-140:150",
    "src/use-session.ts:145:0-145:100",
    "src/use-session.ts:155:0-155:100",
    "src/use-session.ts:180:0-181:150",
    "src/use-session.ts:187:0-187:200"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-authentication-replay/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-authentication-replay/mutation.html"
  }
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignorePatterns": [
    ".stryker-tmp-*"
  ],
  "mutate": [
    "src/work-session-state.tsx:84-85",
    "src/work-session-state-api.ts:195-196"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-pause-resume-session/replay.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-pause-resume-session/replay.html"
  },
  "tempDirName": ".stryker-tmp-pause-resume-session-replay"
}

DB_USERNAME=
DB_PASSWORD=
APP_AUTH_USERNAME=
APP_AUTH_PASSWORD=
WEB_PORT=8080
# Required, never empty: an empty value fails at startup (SessionCookiePolicy).
# Loopback HTTP is accepted for local runs; anything else must be HTTPS.
# Example: https://organization.example.com (no trailing slash).
APP_PUBLIC_ORIGIN=http://127.0.0.1:8080
# Active projects per owner, integer 1-10; all replicas use the same value.
APP_MAX_ACTIVE_PROJECTS=3

# Optional publisher stack (deploy/compose.publisher.yml)
RABBITMQ_USERNAME=
RABBITMQ_PASSWORD=

# Connectors (external calendar and other outbound integrations).
# AES-256-GCM key that encrypts stored connector URLs: exactly 32 bytes, base64.
# Generate with: openssl rand -base64 32
# Leave empty to run degraded: connector routes answer 503 CONNECTORS_DISABLED.
# A malformed value stops the startup on purpose; it never appears in logs.
APP_CONNECTOR_KEY=
# Previous key, kept only while rotating APP_CONNECTOR_KEY. Stored URLs sealed
# with it stay readable and are re-sealed with the current key on the next write.
# Clear it once every subscription has been written again.
APP_CONNECTOR_KEY_PREVIOUS=
# DANGER: setting this to true DISABLES the SSRF guard and lets the backend
# connect to loopback, private, link-local and cloud metadata addresses.
# It exists only so the end-to-end suite can serve a feed from a test container.
# It must stay false in production and in any environment reachable from outside.
APP_CONNECTORS_ALLOW_PRIVATE_ADDRESSES=false

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/history-api.ts",
    "src/history.tsx",
    "src/App.tsx:34:8-34:57",
    "src/App.tsx:67:26-73:36",
    "src/App.tsx:106:10-139:7",
    "src/workspace.tsx:67:10-72:22",
    "src/project-reader.tsx:111:10-116:22",
    "src/task-reader.tsx:112:10-117:22"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-history/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-history/mutation.html"
  },
  "tempDirName": ".stryker-tmp-history"
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/work-session-reader.tsx:232:19-232:38",
    "src/work-session-reader.tsx:242:28-242:65",
    "src/work-session-reader.tsx:243:44-243:63",
    "src/work-session-reader.tsx:255:28-255:61",

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/availability.tsx",
    "src/availability-api.ts",
    "src/workspace.tsx:27:0-41:200",
    "src/workspace.tsx:72:0-72:200",
    "src/use-session.ts:187:0-187:200",
    "src/App.tsx:11:0-11:200",
    "src/App.tsx:14:0-16:200"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-availability/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-availability/mutation.html"
  }
}

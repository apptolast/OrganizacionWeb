{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/work-session-end-api.ts",
    "src/work-session-end.tsx",
    "src/use-work-session-decision.ts",
    "src/work-session-state-api.ts",
    "src/work-session-state.tsx",
    "src/work-session-reader.tsx",
    "src/work-session.tsx"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-end-time-notification/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-end-time-notification/mutation.html"
  },
  "tempDirName": ".stryker-tmp-end-time-notification"
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignorePatterns": [
    ".stryker-tmp-*"
  ],
  "mutate": [
    "src/github-connector-client.ts",
    "src/github-connector.tsx",
    "src/integrations-index.tsx"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html",
    "progress-append-only"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-github-connector/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-github-connector/mutation.html"
  },
  "tempDirName": ".stryker-tmp-github-connector"
}

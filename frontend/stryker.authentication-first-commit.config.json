{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": ["src/use-session.ts:10:0-10:100"],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-authentication-first-commit/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-authentication-first-commit/mutation.html"
  }
}

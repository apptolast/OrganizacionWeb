{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/tasks-api.ts",
    "src/task-validation.ts",
    "src/use-project-tasks.ts",
    "src/project-tasks.tsx"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-create-task/mutation-incremental.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-create-task/mutation-incremental.html"
  },
  "incremental": true,
  "incrementalFile": "reports/mutation-create-task/incremental-cache.json"
}

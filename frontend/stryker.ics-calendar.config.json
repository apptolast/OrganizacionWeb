{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": [
    "@stryker-mutator/vitest-runner"
  ],
  "ignorePatterns": [
    ".stryker-tmp-availability-replay"
  ],
  "mutate": [
    "src/App.tsx:38:8-38:42",
    "src/App.tsx:57:16-58:30",
    "src/App.tsx:94:10-95:37",
    "src/workspace.tsx:97:10-102:22",
    "src/calendar-feed-api.ts",
    "src/calendar.tsx"
  ],
  "reporters": [
    "clear-text",
    "json",
    "html",
    "progress-append-only"
  ],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-ics-calendar/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-ics-calendar/mutation.html"
  },
  "tempDirName": ".stryker-tmp-ics-calendar"
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/App.tsx:49:8-49:51",
    "src/App.tsx:61:12-62:32",
    "src/App.tsx:94:10-95:40",
    "src/workspace.tsx:138:10-143:22",
    "src/automations-api.ts",
    "src/automations.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-automations/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-automations/mutation.html"
  },
  "tempDirName": ".stryker-tmp-automations"
}

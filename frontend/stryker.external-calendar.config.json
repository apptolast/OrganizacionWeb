{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/external-calendar-api.ts",
    "src/external-calendar.tsx",
    "src/today-external-calendar.tsx",
    "src/App.tsx:43:8-43:58",
    "src/App.tsx:53:12-54:34",
    "src/App.tsx:82:10-83:28",
    "src/workspace.tsx:80:10-85:22"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-external-calendar/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-external-calendar/mutation.html"
  },
  "tempDirName": ".stryker-tmp-external-calendar"
}

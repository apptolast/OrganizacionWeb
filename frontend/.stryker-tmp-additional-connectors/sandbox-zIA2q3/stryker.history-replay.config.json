{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/history-api.ts:66:8-70:21",
    "src/history-api.ts:86:11-87:40",
    "src/history-api.ts:91:11-92:62",
    "src/history-api.ts:96:11-97:68",
    "src/history-api.ts:101:11-102:41",
    "src/history.tsx:27:6-27:68",
    "src/history.tsx:233:23-233:43",
    "src/history.tsx:411:26-411:46",
    "src/history.tsx:416:26-416:54"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-history-replay/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-history-replay/mutation.html"
  },
  "tempDirName": ".stryker-tmp-history-replay"
}

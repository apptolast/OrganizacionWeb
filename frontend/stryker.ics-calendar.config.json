{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/App.tsx:35:3-35:43",
    "src/App.tsx:49:13-50:32",
    "src/App.tsx:80:12-81:41",
    "src/workspace.tsx:90:11-95:22",
    "src/calendar-feed-api.ts",
    "src/calendar.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": { "high": 90, "low": 80, "break": 80 },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": { "configFile": "vite.config.ts" },
  "jsonReporter": { "fileName": "reports/mutation-ics-calendar/mutation.json" },
  "htmlReporter": { "fileName": "reports/mutation-ics-calendar/mutation.html" },
  "tempDirName": ".stryker-tmp-ics-calendar"
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/appearance-api.ts",
    "src/appearance-state.tsx",
    "src/appearance.tsx",
    "src/App.tsx:40:8-40:44",
    "src/App.tsx:75:26-87:42",
    "src/App.tsx:120:10-161:7",
    "src/workspace.tsx:88:10-93:22",
    "src/session-gate.tsx:32:2-52:6",
    "src/use-session.ts:208:0-229:1"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-appearance/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-appearance/mutation.html"
  },
  "tempDirName": ".stryker-tmp-appearance"
}

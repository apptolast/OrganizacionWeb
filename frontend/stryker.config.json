{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/projects-api.ts",
    "src/use-create-project.ts",
    "src/read-projects-api.ts",
    "src/use-read-projects.ts",
    "src/navigation.tsx",
    "src/edit-project-api.ts",
    "src/use-edit-project.ts",
    "src/project-status.ts",
    "src/use-project-status.ts",
    "src/api-client.ts",
    "src/session-api.ts",
    "src/use-session.ts",
    "src/session-gate.tsx:22:0-31:100",
    "src/tasks-api.ts",
    "src/task-validation.ts",
    "src/use-project-tasks.ts",
    "src/project-tasks.tsx"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  }
}

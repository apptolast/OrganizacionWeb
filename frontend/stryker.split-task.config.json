{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "mutate": [
    "src/tasks-api.ts",
    "src/task-reader.tsx",
    "src/task-parent.tsx",
    "src/project-tasks.tsx",
    "src/use-project-tasks.ts:34:0-42:200",
    "src/use-project-tasks.ts:64:0-78:200",
    "src/App.tsx:10:0-14:200",
    "src/use-session.ts:187:0-189:200"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-split-task/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-split-task/mutation.html"
  }
}

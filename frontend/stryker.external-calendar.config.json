{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/external-calendar-api.ts",
    "src/external-calendar.tsx",
    "src/today-external-calendar.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": { "high": 90, "low": 80, "break": 80 },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": { "configFile": "vite.config.ts" },
  "jsonReporter": {
    "fileName": "reports/mutation-external-calendar/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-external-calendar/mutation.html"
  },
  "tempDirName": ".stryker-tmp-external-calendar"
}

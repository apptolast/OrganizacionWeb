{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/import-data-api.ts",
    "src/import-data-intent.ts",
    "src/import-data.tsx",
    "src/App.tsx:27:8-27:41",
    "src/App.tsx:33:8-33:45",
    "src/App.tsx:41:8-57:30",
    "src/App.tsx:60:7-113:7",
    "src/workspace.tsx:88:10-96:22",
    "src/use-session.ts:5:0-11:1",
    "src/use-session.ts:44:6-50:36",
    "src/use-session.ts:68:6-68:29",
    "src/use-session.ts:143:4-143:27",
    "src/use-session.ts:208:6-208:29",
    "src/appearance-state.tsx:35:2-37:3",
    "src/appearance-state.tsx:171:8-177:9",
    "src/customization-state.ts:411:4-466:5"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-import-data/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-import-data/mutation.html"
  },
  "tempDirName": ".stryker-tmp-import-data",
  "incremental": true,
  "incrementalFile": "../progress/import_stryker_incremental/cache.json"
}

{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/history-api.ts",
    "src/history.tsx",
    "src/App.tsx:31:8-31:57",
    "src/App.tsx:59:24-65:34",
    "src/App.tsx:92:10-125:7",
    "src/workspace.tsx:66:10-71:22",
    "src/project-reader.tsx:111:10-116:22",
    "src/task-reader.tsx:112:10-117:22"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  },
  "jsonReporter": {
    "fileName": "reports/mutation-history/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-history/mutation.html"
  },
  "tempDirName": ".stryker-tmp-history"
}

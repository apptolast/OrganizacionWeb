{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-availability-replay"],
  "mutate": [
    "src/projects-api.ts",
    "src/use-create-project.ts",
    "src/read-projects-api.ts",
    "src/use-read-projects.ts",
    "src/navigation.tsx",
    "src/edit-project-api.ts",
    "src/use-edit-project.ts",
    "src/project-status.ts",
    "src/use-project-status.ts",
    "src/api-client.ts",
    "src/session-api.ts",
    "src/use-session.ts",
    "src/session-gate.tsx:22:0-31:100",
    "src/tasks-api.ts",
    "src/task-validation.ts",
    "src/use-project-tasks.ts",
    "src/project-tasks.tsx",
    "src/task-reader.tsx",
    "src/task-parent.tsx",
    "src/task-state.tsx",
    "src/task-history.tsx",
    "src/task-status-api.ts",
    "src/availability.tsx",
    "src/availability-api.ts",
    "src/schedule-block-api.ts",
    "src/task-blocks.tsx",
    "src/today-api.ts",
    "src/today.tsx",
    "src/App.tsx:10:0-49:1",
    "src/workspace.tsx:27:0-54:22",
    "src/workspace.tsx:85:0-85:64",
    "src/project-reader.tsx:61:0-61:70",
    "src/project-reader.tsx:157:0-157:76"
  ],
  "reporters": ["clear-text", "json", "html"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 2,
  "coverageAnalysis": "perTest",
  "vitest": {
    "configFile": "vite.config.ts"
  }
}

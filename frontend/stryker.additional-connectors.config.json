{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "testRunner": "vitest",
  "plugins": ["@stryker-mutator/vitest-runner"],
  "ignorePatterns": [".stryker-tmp-*"],
  "mutate": [
    "src/connectors-catalog-client.ts",
    "src/connectors-catalog.tsx",
    "src/gitlab-connector-client.ts",
    "src/gitlab-connector.tsx"
  ],
  "reporters": ["clear-text", "json", "html", "progress-append-only"],
  "thresholds": {
    "high": 90,
    "low": 80,
    "break": 80
  },
  "concurrency": 8,
  "coverageAnalysis": "perTest",
  "vitest": { "configFile": "vite.config.ts" },
  "jsonReporter": {
    "fileName": "reports/mutation-additional-connectors/mutation.json"
  },
  "htmlReporter": {
    "fileName": "reports/mutation-additional-connectors/mutation.html"
  },
  "tempDirName": ".stryker-tmp-additional-connectors"
}
